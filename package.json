{
  "name": "cosint",
  "version": "1.8.7",
  "description": "Tableau collaboratif OSINT en pair-à-pair — aucune donnée sur serveur",
  "main": "./out/main/index.js",
  "author": "COSINT",
  "homepage": "https://cosint.interne.local",
  "repository": {
    "type": "git",
    "url": "https://github.com/k0nrd/COSINT.git"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:icon": "node scripts/generate-icon.mjs",
    "build:win": "npm run build:icon && npm run build && electron-builder --win --x64",
    "build:linux": "npm run build && electron-builder --linux --x64",
    "release": "npm run build:icon && npm run build && electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "@xyflow/react": "^12.4.2",
    "electron-updater": "^6.8.9",
    "html-to-image": "^1.11.11",
    "lucide-react": "^0.469.0",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.6",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.21",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.5"
  }
}
